    },
    "quiz_length": {
     "type": "enum",
     "required": true,
     "description": "",
     "enum": [
      "short",
      "long"
     ]
    },
    "entry_mode": {
     "type": "enum",
     "required": true,
     "description": "",
     "enum": [
      "write",
      "tap"
     ]
    }
   },
