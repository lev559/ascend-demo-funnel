{
 "version": "3.0",
 "convention": "snake_case object_action in past tense; properties snake_case; money in USD as number; no free text, names or emails in event properties",
 "super_properties": {
  "platform": {
   "type": "enum",
   "required": true,
   "description": "Where the event fired",
   "enum": [
    "web",
    "ios",
    "android",
    "server"
   ]
  },
  "funnel_version": {
   "type": "string",
   "required": true,
   "description": "e.g. v3; bump on any change to screens or events"
  },
  "angle": {
   "type": "string",
   "required": true,
   "description": "Ad angle from ?angle= / utm_content"
  },
  "utm_source": {
   "type": "string",
   "required": true,
   "description": ""
  },
  "utm_medium": {
   "type": "string",
   "required": false,
   "description": ""
  },
  "utm_campaign": {
   "type": "string",
   "required": true,
   "description": ""
  },
  "utm_content": {
   "type": "string",
   "required": false,
   "description": ""
  },
  "channel": {
   "type": "enum",
   "required": true,
   "description": "Derived from utm_source",
   "enum": [
    "meta",
    "tiktok",
    "google",
    "organic",
    "referral"
   ]
  },
  "exp_quiz_length": {
   "type": "string",
   "required": false,
   "description": ""
  },
  "exp_entry_mode": {
   "type": "string",
   "required": false,
   "description": ""
  },
  "exp_chat_length": {
   "type": "string",
   "required": false,
   "description": ""
  },
  "exp_paywall_model": {
   "type": "string",
   "required": false,
   "description": ""
  },
  "exp_upsell_offer": {
   "type": "string",
   "required": false,
   "description": ""
  }
 },
 "profile_properties": {
  "$email": {
   "type": "string",
   "required": false,
   "description": "Not sent in this build (no messaging tool needs it). Would be set after email_submitted with consent"
  },
  "first_seen": {
   "type": "date",
   "required": true,
   "description": ""
  },
  "signup_date": {
   "type": "date",
   "required": false,
   "description": ""
  },
  "acquisition_channel": {
   "type": "string",
   "required": true,
   "description": ""
  },
  "first_angle": {
   "type": "string",
   "required": true,
   "description": ""
  },
  "reason": {
   "type": "enum",
   "required": true,
   "description": "",
   "enum": [
    "overload",
    "start",
    "lost",
    "talk"
   ]
  },
  "age_band": {
   "type": "string",
   "required": false,
   "description": ""
  },
  "coach": {
   "type": "enum",
   "required": true,
   "description": "",
   "enum": [
    "nora",
    "ines",
    "max",
    "theo"
   ]
  },
  "marketing_opt_in": {
   "type": "boolean",
   "required": false,
   "description": ""
  },
  "plan": {
   "type": "enum",
   "required": false,
   "description": "",
   "enum": [
    "1w",
    "4w",
    "12w",
    "year",
    "month",
    "4w_back"
   ]
  },
  "subscription_status": {
   "type": "enum",
   "required": false,
   "description": "",
   "enum": [
    "none",
    "trialing",
    "active",
    "cancelled",
    "past_due",
    "ended"
   ]
  },
  "ltv_usd": {
   "type": "number",
   "required": false,
   "description": "Net revenue to date (renewals + upsells − refunds), set by the webhook"
  },
  "periods_paid": {
   "type": "number",
   "required": false,
   "description": ""
  }
