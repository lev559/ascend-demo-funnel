     "type": "enum",
     "required": true,
     "description": "",
     "enum": [
      "overload",
      "start",
      "lost",
      "talk"
     ]
    },
    "how": {
     "type": "enum",
     "required": true,
     "description": "",
     "enum": [
      "typed",
      "example",
      "tap"
     ]
    },
    "entry_mode": {
     "type": "enum",
     "required": true,
     "description": "",
     "enum": [
      "write",
      "tap"
