# Everything is optional: without keys the funnel still runs end to end
# (experiments assigned locally, events printed to the browser console, the coach uses its written fallbacks).

# GrowthBook: Features -> SDK Connections -> client key
NEXT_PUBLIC_GROWTHBOOK_API_HOST=https://cdn.growthbook.io
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Mixpanel: Project settings -> Project token
NEXT_PUBLIC_MIXPANEL_TOKEN=
# set to https://api-eu.mixpanel.com if the project uses EU data residency
NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com

# Google Tag Manager container (Meta Pixel and GA4 are added inside GTM)
NEXT_PUBLIC_GTM_ID=

# Stripe TEST mode secret key (starts with sk_test_). Live keys are refused by the code.
STRIPE_SECRET_KEY=

# AI coach (questions, chat, plan). Without a key the coach uses its written fallbacks.
# Endpoint and model default to Cloudflare Workers AI in lib/config.js; set these only to override.
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
